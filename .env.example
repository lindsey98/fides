# --- Tutorial.ipynb (Azure OpenAI) ---------------------------------------------------
AZURE_ENDPOINT = "https://example.openai.azure.com"
API_VERSION = "2025-03-01-preview"
AZURE_DEPLOYMENT = "gpt-4.1"

# --- AgentDojo / AgentDyn defense harness (main.py) ----------------------------------
# Set the key(s) for the provider(s) of the --model you run. Routing is by model name:
#   gpt-*                 -> OpenAI            (OPENAI_API_KEY[, OPENAI_BASE_URL])
#   gemini-*              -> Google Vertex     (GCP_PROJECT, GCP_LOCATION + ADC), or an
#                            OpenAI-compatible relay if OPENAI_BASE_URL is set
#   anthropic:* | claude* -> Anthropic         (ANTHROPIC_API_KEY)
#   org/model (a slash)   -> OpenRouter         (OPENROUTER_API_KEY)
#   local:* | bare name   -> local OpenAI server(LOCAL_API_BASE, LOCAL_API_KEY)

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GCP_PROJECT=
# GCP_LOCATION=us-central1
# LOCAL_API_BASE=http://localhost:8000/v1
# LOCAL_API_KEY=EMPTY
# FIDES_LOCAL_PROMPTED=0        # set 1 if the local server lacks native tool-calling
